{
  "name": "energyiq-workspace",
  "private": true,
  "description": "EnergyIQ — AI-Powered Building Energy Intelligence monorepo",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "test": "npm --prefix frontend run test",
    "lint": "npm --prefix frontend run lint",
    "format": "npm --prefix frontend run format",
    "dev:backend": "cd backend && python -m uvicorn app.main:app --reload --host 0.0.0.0 --port 8000",
    "seed:backend": "cd backend && python -m app.cli seed",
    "train:backend": "cd backend && python -m app.cli train",
    "detect:backend": "cd backend && python -m app.cli detect",
    "test:backend": "cd backend && python -m pytest",
    "test:all": "npm run test:backend && npm run test"
  }
}
